# HTTP listen address
HTTP_ADDR=:8000

# Postgres (goose migrate + API). Empty: healthz still works, auth returns 503.
DATABASE_URL=postgres://osspilot:osspilot@127.0.0.1:5432/osspilot_tenant?sslmode=disable

# JWT
JWT_SECRET=change-me-in-development
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ceph RGW / S3. Empty: healthz still works, upload/download return 503.
S3_ENDPOINT=https://s3.example.com
RGW_ACCESS_KEY=your-access-key
RGW_SECRET_KEY=your-secret-key
S3_REGION=us-east-1

# Optional CDN / object domains (overridden by platform_settings when set)
# DOWNLOAD_CDN_URL=
# PREVIEW_CDN_URL=
# OBJECT_HTTP_DOMAIN=
# OBJECT_HTTPS_DOMAIN=

# Shared with ops-api. Empty: internal projection routes return 503.
# PROJECTION_SECRET=change-me-together-with-ops

# Origins written as default bucket CORS on create (browser presigned uploads).
# TENANT_CORS_ORIGINS=http://localhost:5173

# ONLYOFFICE. office_url in platform_settings overrides OFFICE_URL.
# OFFICE_URL=http://127.0.0.1:8080
# OFFICE_JWT_SECRET=
# Optional Redis for cmd/worker inventory. API does not require it.
# REDIS_URL=redis://127.0.0.1:6379/0
